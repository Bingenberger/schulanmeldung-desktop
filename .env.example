# Runtime mode: development, testing or production
SL_OFFICE_ENV=production
# Generate with: openssl rand -hex 32
SL_OFFICE_SECRET_KEY=replace-with-at-least-32-random-characters
SL_OFFICE_DATABASE_URL=postgresql+psycopg://user:password@database/sl_office
SL_OFFICE_UPLOAD_FOLDER=/var/lib/sl-office/documents
SL_OFFICE_MAX_UPLOAD_BYTES=10485760
SL_OFFICE_MAX_EXCEL_BYTES=5242880
SL_OFFICE_SESSION_MINUTES=60
SL_OFFICE_MAIL_SERVER=smtp.example.org
SL_OFFICE_MAIL_PORT=587
SL_OFFICE_MAIL_USE_TLS=true
SL_OFFICE_MAIL_USERNAME=
SL_OFFICE_MAIL_PASSWORD=
SL_OFFICE_MAIL_FROM=schulanmeldung@example.org

# Briefkopf der Elternschreiben (Vorgaben stehen in config.py, hier nur bei
# abweichenden Angaben setzen)
SL_OFFICE_SCHOOL_NAME="Gemeinschaftsgrundschule Niederkassel"
SL_OFFICE_SCHOOL_MOTTO="zusammen · leben · lernen"
SL_OFFICE_SCHOOL_STREET="Annostraße 3"
SL_OFFICE_SCHOOL_CITY_LINE="53859 Niederkassel"
SL_OFFICE_SCHOOL_PHONE="(02208) 3761"
SL_OFFICE_SCHOOL_EMAIL="info@ggs-niederkassel.de"
SL_OFFICE_SCHOOL_WEB="www.ggs-niederkassel.de"
# Ort der Datumszeile und Stadt des Anmeldescheins
SL_OFFICE_SCHOOL_TOWN="Niederkassel"
# Einzugsbereich, wie er im Brieftext genannt wird
SL_OFFICE_SCHOOL_DISTRICT="Niederkassel-Ort"
SL_OFFICE_SCHOOL_HEALTH_OFFICE="Gesundheitsamtes Siegburg"
# Ansprechadresse für Rückfragen zur Terminbuchung (leer = Absatz entfällt)
SL_OFFICE_SCHOOL_CONTACT_MAIL="emrich-foerster@ggs-ndk.de"
SL_OFFICE_SCHOOL_HEAD="F. Emrich-Förster, Schulleiter"
# Logo und Unterschrift; Vorgabe ist assets/briefkopf/
SL_OFFICE_SCHOOL_LOGO="/home/emrichschule/SL-Office/assets/briefkopf/logo.png"
SL_OFFICE_SCHOOL_SIGNATURE="/home/emrichschule/SL-Office/assets/briefkopf/unterschrift.png"
