# Runtime mode: development, testing or production
SL_OFFICE_ENV=production
# Generate with: openssl rand -hex 32
SL_OFFICE_SECRET_KEY=replace-with-at-least-32-random-characters
SL_OFFICE_DATABASE_URL=postgresql+psycopg://user:password@database/sl_office
SL_OFFICE_UPLOAD_FOLDER=/var/lib/sl-office/documents
SL_OFFICE_MAX_UPLOAD_BYTES=10485760
SL_OFFICE_MAX_EXCEL_BYTES=5242880
SL_OFFICE_SESSION_MINUTES=60
# Anzahl vorgeschalteter Reverse Proxys. Hinter nginx: 1. Ohne diesen Wert
# baut die Anwendung die Aktivierungslinks der Elternbriefe als http:// mit
# dem internen Hostnamen. Ohne Proxy davor muss der Wert 0 bleiben.
SL_OFFICE_TRUSTED_PROXIES=1
SL_OFFICE_MAIL_SERVER=smtp.example.org
SL_OFFICE_MAIL_PORT=587
SL_OFFICE_MAIL_USE_TLS=true
SL_OFFICE_MAIL_USERNAME=
SL_OFFICE_MAIL_PASSWORD=
SL_OFFICE_MAIL_FROM=schulanmeldung@example.org
# Empfänger der Benachrichtigung, wenn Eltern einen Termin buchen.
# Ohne Angabe geht sie an SL_OFFICE_SCHOOL_CONTACT_MAIL; ist auch die leer,
# wird kein Hinweis verschickt.
SL_OFFICE_NOTIFY_MAIL=
# Vorlauf der Terminerinnerung an die Eltern, in Stunden.
SL_OFFICE_REMINDER_HOURS=24
# Öffentliche Adresse der Anwendung. Der Erinnerungsdienst läuft ohne Anfrage
# und baut den Link zum Elternbereich sonst nicht.
SL_OFFICE_PUBLIC_BASE_URL=https://anmeldung.example.org

# Briefkopf der Elternschreiben. Normalerweise unter „Verwaltung → Schulprofil“
# gepflegt; diese Werte gelten nur, solange dort nichts gespeichert ist.
SL_OFFICE_SCHOOL_NAME=""
SL_OFFICE_SCHOOL_MOTTO=""
SL_OFFICE_SCHOOL_STREET=""
SL_OFFICE_SCHOOL_CITY_LINE=""
SL_OFFICE_SCHOOL_PHONE=""
SL_OFFICE_SCHOOL_EMAIL=""
SL_OFFICE_SCHOOL_WEB=""
# Ort der Datumszeile und Stadt des Anmeldescheins
SL_OFFICE_SCHOOL_TOWN=""
# Einzugsbereich, wie er im Brieftext genannt wird
SL_OFFICE_SCHOOL_DISTRICT=""
SL_OFFICE_SCHOOL_HEALTH_OFFICE=""
# Ansprechadresse für Rückfragen zur Terminbuchung (leer = Absatz entfällt)
SL_OFFICE_SCHOOL_CONTACT_MAIL=""
SL_OFFICE_SCHOOL_HEAD=""
# Pfade zu Logo und Unterschrift; im Schulprofil hochgeladene Bilder gehen vor
SL_OFFICE_SCHOOL_LOGO=""
SL_OFFICE_SCHOOL_SIGNATURE=""
